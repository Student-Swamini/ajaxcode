<?php

$conn = pg_connect(
    "host=localhost port=5432 dbname=postgres user=postgres"
);

$name = $_GET['name'];

$result = pg_query(
    $conn,
    "SELECT * FROM teachers WHERE name='$name'"
);

echo "<table border='1'>";

echo "<tr>";
echo "<th>No</th>";
echo "<th>Name</th>";
echo "<th>Qualification</th>";
echo "<th>Salary</th>";
echo "</tr>";

while ($row = pg_fetch_assoc($result))
{
    echo "<tr>";

    echo "<td>" . $row['no'] . "</td>";
    echo "<td>" . $row['name'] . "</td>";
    echo "<td>" . $row['qualification'] . "</td>";
    echo "<td>" . $row['salary'] . "</td>";

    echo "</tr>";
}

echo "</table>";

?>
